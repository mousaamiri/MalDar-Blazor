@using MalDar.UI.Models
@using Microsoft.JSInterop
@inject IJSRuntime JS
<li>
    <a href="/products/@Item.Id">@Item.Name - @Item.Price.ToString("C") ریال</a>
    <button @onclick="HandleDeleteClick">حذف</button>
</li>

@code {
    [Parameter] public ProductItem Item { get; set; } = null!;
    [Parameter] public EventCallback<ProductItem> OnDelete { get; set; }

    private async Task HandleDeleteClick()
    {
        var confirmed = await JS.InvokeAsync<bool>("productInterop.confirmDelete", Item.Name);
        if (confirmed)
        {
            await OnDelete.InvokeAsync(Item);
        }
    }
}