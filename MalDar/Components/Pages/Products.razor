@page "/products"
@inject IProductService ProductService
@rendermode @(new InteractiveServerRenderMode(prerender:false))
@* Using PersistentComponentState Is Better way *@
@using MalDar.Models
@using MalDar.Services


<h3>لیست کالاها</h3>
@if (_isLoading)
{
    <p>در حال بارگذاری .... </p>
}
else
{
    <EditForm Model="_newProduct" OnValidSubmit="AddItem">
        <DataAnnotationsValidator/>
        <ValidationSummary/>

        <input @bind="_newProduct.Name" @bind:event="oninput" placeholder="نام کالا"/>
        <input @bind="_newProduct.Price" type="number" placeholder="قیمت" />
        <button type="submit" >افزودن</button>
    </EditForm>
    <ul>
        @foreach (var item in _items)
        {
            <ProductRow Item="item" OnDelete="RemoveItem" />
        }
    </ul>
}

@code {

    private bool _isLoading=true;
    private List<ProductItem> _items = [];
    private AddProductRequest _newProduct = new();
    protected override async Task OnInitializedAsync()
    {
        _isLoading = true;
        _items = await ProductService.GetAllProductsAsync();
        _isLoading = false;
    }


    private async Task AddItem()
    {
        if (string.IsNullOrEmpty(_newProduct.Name)) return;
        var newProduct = await ProductService.AddProductAsync(_newProduct);
        _items = await ProductService.GetAllProductsAsync();
        _newProduct = new AddProductRequest();
    }
    private async Task RemoveItem(ProductItem obj)
    {
        await ProductService.RemoveProductAsync(obj.Id);
        _items = await ProductService.GetAllProductsAsync();
    }

    

}