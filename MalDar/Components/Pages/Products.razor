@page "/products"
@rendermode InteractiveServer
@using MalDar.Models


<h3>لیست کالاها</h3>
<div>
    <input @bind="newName" @bind:event="oninput" placeholder="نام کالا"/>
    <input @bind="newPrice" type="number" placeholder="قیمت"/>
    <button @onclick="AddItem">افزودن</button>
</div>
<ul>
    @foreach (var item in _items)
    {
        <ProductRow Item="item" OnDelete="RemoveItem" />
    }
</ul>

@code {
    private readonly List<ProductItem> _items =
    [
        new ProductItem("برنج", 850000),
        new ProductItem("روغن", 320000),
        new ProductItem("قند", 150000)
    ];

    private string newName = "";
    private decimal newPrice;
    private void AddItem()
    {
        if(string.IsNullOrEmpty(newName))return;
        _items.Add(new ProductItem(newName, newPrice));
        newName = "";
        newPrice = 0;
    }
    private void RemoveItem(ProductItem obj)
    {
        _items.Remove(obj);
    }

    

}