@page "/products/{Id:int}"
@inject ProductApiClient ApiClient
@rendermode @(new InteractiveServerRenderMode(prerender:false))
@using MalDar.Models
@using MalDar.Services

@if (_isLoading)
{
    <p>در حال بارگذاری ...</p>
}
else if(_item is null)
{
    <p>کالایی با این شناسیه یافت نشد</p>
}
else
{
    <h3>@_item.Name</h3>
    <p>قیمت: @_item.Price.ToString("C") تومان</p>
}
<a href="/products">بازگشت به لیست</a>
@code
{
    [Parameter] public int Id { get; set; }
    private ProductItem? _item;
    private bool _isLoading = true;
    protected override async Task OnInitializedAsync()
    {
        _item = await ApiClient.GetByIdAsync(Id);
        _isLoading = false;
    }
 
}
